# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB must be a replica set — bookings run inside a transaction.
# Atlas free tier (M0) already is one; paste its SRV string here.
# Local alternative: start mongod with --replSet rs0, then run rs.initiate()
# in mongosh, and use mongodb://127.0.0.1:27017/eventease?replicaSet=rs0
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/eventease?retryWrites=true&w=majority

# At least 24 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Where the Vite client runs. Comma-separate to allow more than one origin.
CLIENT_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=12
